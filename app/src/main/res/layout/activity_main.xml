<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09100E"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Bat emblem"
                android:src="@drawable/bat_emblem" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Bat"
                android:textColor="#F3F8F5"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/menuButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:contentDescription="Bat menu"
                android:text="⋮"
                android:textColor="#E8F4F0"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add an event"
                android:textColor="#F3F8F5"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Paste details or speak an explicit event command."
                android:textColor="#AEBBB4"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/manualText"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="Event title, date, time, and location"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="14dp"
                android:textColor="#F3F8F5"
                android:textColorHint="#82918A"
                android:textSize="15sp" />

            <Button
                android:id="@+id/reviewButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button"
                android:text="Review event"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_voice"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice input"
                android:textColor="#061312"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Say: “Bat, add AI workshop tomorrow at 4 p.m.”"
                android:textColor="#0E3C38"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/voiceTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="#E8F4F0"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/voiceButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button"
                android:text="Speak an event command"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nothing is added until you confirm."
            android:textColor="#AEBBB4"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
